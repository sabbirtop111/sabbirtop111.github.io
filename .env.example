# The portfolio is designed to work out-of-the-box using local data 
# located in '/src/data/'. 
#
# If you wish to use a live backend, provide the endpoint below.
#
# API response MUST follow the exact JSON schema found in
# - /src/data/ directory

PUBLIC_API_URL=https://api.example.com

# Overrides siteUrl from home.json at build time.
# Useful in CI/CD pipelines (e.g. Vercel, Netlify) where the
# deployment URL is injected as a secret instead of being committed.
SITE_URL=https://your-domain.com