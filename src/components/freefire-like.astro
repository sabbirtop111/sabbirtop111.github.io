---
import { Icon } from 'astro-icon/components';
---

<div class="mt-8 rounded-2xl border border-accent/15 bg-accent/5 p-6 md:p-8">
  <div class="flex items-center gap-2 mb-1 flex-wrap">
    <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border text-pink-400 bg-pink-400/10 border-pink-400/20">
      <span data-en="Like API only" data-bn="শুধু Like API">Like API only</span>
    </span>
  </div>
  <h3 class="text-xl font-heading font-bold text-maintext mb-1" data-en="Free Fire Like Sender" data-bn="Free Fire লাইক পাঠাও">❤️ Free Fire Like Sender</h3>
  <p class="text-subtext text-sm font-body mb-5" data-en="Send a free like to any Free Fire UID — limited to one like per account per day." data-bn="যেকোনো Free Fire UID-তে ফ্রি লাইক পাঠাও। এক UID-তে দিনে একবার।">
    Send a free like to any Free Fire UID — limited to one like per account per day.
  </p>

  <div class="flex flex-col sm:flex-row gap-3">
    <input id="ff-like-uid" type="text" inputmode="numeric" placeholder="Enter your Free Fire UID" value="" autocomplete="off" class="flex-1 px-4 py-2.5 rounded-lg bg-background/60 border border-white/10 text-maintext text-sm font-body placeholder:text-subtext/50 focus:outline-none focus:border-accent/50" />
    <label for="ff-like-server" class="sr-only">Server</label>
    <select id="ff-like-server" aria-label="Server" class="px-3 py-2.5 rounded-lg bg-background/60 border border-white/10 text-maintext text-sm font-body focus:outline-none focus:border-accent/50">
      <option value="BD">BD</option>
      <option value="IND">IND</option>
      <option value="SG">SG</option>
      <option value="TH">TH</option>
      <option value="VN">VN</option>
      <option value="PK">PK</option>
      <option value="ME">ME</option>
      <option value="BR">BR</option>
      <option value="US">US</option>
    </select>
    <button id="ff-like-btn" type="button" class="px-6 py-2.5 rounded-lg bg-accent/20 border border-accent/40 text-maintext text-sm font-body font-semibold hover:bg-accent/30 transition-colors whitespace-nowrap">Send Like</button>
  </div>

  <p id="ff-like-error" class="text-red-400 text-xs font-body mt-3 hidden"></p>
  <p id="ff-like-note" class="text-amber-300 text-xs font-body mt-3 hidden"></p>
  <div id="ff-like-loading" class="hidden mt-6 items-center gap-2 text-subtext text-sm font-body">Calling Like API...</div>

  <div id="ff-like-result" class="hidden mt-6">
    <div class="flex items-center gap-3 pb-4 border-b border-white/10">
      <div class="min-w-0 flex-1">
        <p id="ff-like-name" class="text-maintext font-heading font-bold text-base truncate"></p>
        <p id="ff-like-uid-display" class="text-subtext text-[11px] font-body"></p>
      </div>
      <div class="flex flex-wrap gap-2 justify-end">
        <button id="ff-like-copy" type="button" class="text-[11px] px-3 py-1.5 rounded-full border border-white/10 text-subtext">Copy</button>
        <button id="ff-like-download" type="button" class="text-[11px] px-3 py-1.5 rounded-full border border-accent/40 text-maintext bg-accent/15">Download card</button>
        <button id="ff-like-share" type="button" class="text-[11px] px-3 py-1.5 rounded-full border border-white/10 text-subtext">Share</button>
      </div>
    </div>
    <div id="ff-like-card" class="mt-4 rounded-2xl border border-pink-400/30 bg-background/70 p-4 md:p-5">
      <p class="text-[10px] uppercase tracking-[0.2em] text-pink-400 mb-2">Gamer Sabbir • Like Card</p>
      <p id="ff-like-card-name" class="font-heading font-bold text-xl text-maintext"></p>
      <p id="ff-like-card-uid" class="text-xs text-subtext mb-3"></p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
        <div><p class="text-[10px] text-subtext uppercase">Given now</p><p id="ff-like-given" class="font-semibold"></p></div>
        <div><p class="text-[10px] text-subtext uppercase">Before</p><p id="ff-like-before" class="font-semibold"></p></div>
        <div><p class="text-[10px] text-subtext uppercase">After</p><p id="ff-like-after" class="font-semibold"></p></div>
        <div><p class="text-[10px] text-subtext uppercase">Status</p><p id="ff-like-status" class="font-semibold"></p></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const uidInput = document.getElementById('ff-like-uid');
    const serverSelect = document.getElementById('ff-like-server');
    const btn = document.getElementById('ff-like-btn');
    const errorEl = document.getElementById('ff-like-error');
    const noteEl = document.getElementById('ff-like-note');
    const loadingEl = document.getElementById('ff-like-loading');
    const resultEl = document.getElementById('ff-like-result');
    let lastText = '';
    let lastCard = null;
    let sending = false;

    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    }
    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }
    function showNote(msg) {
      if (!noteEl) return;
      noteEl.textContent = msg;
      noteEl.classList.remove('hidden');
    }

    function renderFromLikeApi(data, server) {
      const given = Number(data.LikesGivenByAPI ?? 0);
      const before = Number(data.LikesbeforeCommand ?? 0);
      const after = Number(data.LikesafterCommand ?? 0);
      const status = Number(data.status);
      const name = data.PlayerNickname || 'Unknown';
      const uid = data.UID || '';
      const sent = status === 1 && given > 0;
      const label = sent ? '✅ Like sent' : '⏳ Already liked today';

      setText('ff-like-name', name);
      setText('ff-like-uid-display', 'UID: ' + uid);
      setText('ff-like-card-name', name);
      setText('ff-like-card-uid', 'UID ' + uid + ' • ' + server);
      setText('ff-like-given', given);
      setText('ff-like-before', before);
      setText('ff-like-after', after);
      setText('ff-like-status', label);
      resultEl?.classList.remove('hidden');

      lastCard = { name, uid, server, given, before, after, label };
      lastText = name + ' (' + uid + ')\nLikes before: ' + before + '\nLikes after: ' + after + '\n' + label;

      if (sent) showNote('Sent ' + given + ' like(s). Total went from ' + before + ' to ' + after + '.');
      else showNote('This UID already got a like today. Come back tomorrow for another one.');
    }

    async function sendLike() {
      if (sending) return;
      const uid = uidInput instanceof HTMLInputElement ? uidInput.value.trim() : '';
      const server = serverSelect instanceof HTMLSelectElement ? serverSelect.value : 'BD';
      errorEl?.classList.add('hidden');
      noteEl?.classList.add('hidden');
      resultEl?.classList.add('hidden');
      if (!uid || !/^\d{5,20}$/.test(uid)) {
        showError('Enter your own Free Fire UID first.');
        return;
      }
      sending = true;
      if (btn instanceof HTMLButtonElement) btn.disabled = true;
      loadingEl?.classList.remove('hidden');

      const url = 'https://sabbir-paid-api2.vercel.app/like?uid=' + encodeURIComponent(uid) + '&server_name=' + encodeURIComponent(server);
      try {
        const res = await fetch(url, { cache: 'no-store', mode: 'cors' });
        const data = await res.json();
        if (!data || data.status == null) throw new Error('bad json');
        renderFromLikeApi(data, server);
      } catch {
        showError('Like API response not readable right now. Real card data is LikesGivenByAPI / LikesbeforeCommand / LikesafterCommand / status.');
      } finally {
        sending = false;
        if (btn instanceof HTMLButtonElement) btn.disabled = false;
        loadingEl?.classList.add('hidden');
      }
    }

    function buildCardCanvas() {
      if (!lastCard) return null;
      const canvas = document.createElement('canvas');
      canvas.width = 900;
      canvas.height = 520;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      ctx.fillStyle = '#14010f';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = '#FF4D8D';
      ctx.lineWidth = 8;
      ctx.strokeRect(24, 24, canvas.width - 48, canvas.height - 48);
      ctx.fillStyle = '#FF4D8D';
      ctx.font = '700 22px sans-serif';
      ctx.fillText('GAMER SABBIR  •  LIKE CARD', 60, 90);
      ctx.fillStyle = '#ffffff';
      ctx.font = '700 48px sans-serif';
      ctx.fillText(String(lastCard.name).slice(0, 22), 60, 160);
      ctx.fillStyle = '#FF4D8D';
      ctx.font = '500 22px sans-serif';
      ctx.fillText('UID ' + lastCard.uid + '   ' + lastCard.server, 60, 200);
      ctx.fillStyle = '#ffffff';
      ctx.font = '600 26px sans-serif';
      ctx.fillText('Given   ' + lastCard.given, 60, 290);
      ctx.fillText('Before  ' + lastCard.before, 360, 290);
      ctx.fillText('After   ' + lastCard.after, 60, 350);
      ctx.fillText(String(lastCard.label), 60, 410);
      return canvas;
    }

    btn?.addEventListener('click', sendLike);
    uidInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendLike(); });
    document.getElementById('ff-like-copy')?.addEventListener('click', async () => {
      if (lastText) await navigator.clipboard.writeText(lastText).catch(() => {});
    });
    document.getElementById('ff-like-download')?.addEventListener('click', () => {
      const canvas = buildCardCanvas();
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'ff-like-' + (lastCard?.uid || 'player') + '.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
    document.getElementById('ff-like-share')?.addEventListener('click', async () => {
      if (!lastText) return;
      try {
        if (navigator.share) await navigator.share({ title: 'Free Fire Like Card', text: lastText });
        else await navigator.clipboard.writeText(lastText);
      } catch {}
    });
  });
</script>
