---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import projectsData from '../data/projects.json';
import techData from '../data/tech.json';
import careerData from '../data/career.json';
import { resolveAssetImage } from '../utils/images';
import { Image } from 'astro:assets';

const projectCount = projectsData.length;
const skillCount = techData.categories.reduce((sum, cat) => sum + cat.skills.length, 0);
const careerCount = careerData.length;

//Data Definitions
interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  description: string;
  descriptionHtml: string;
  resumeUrl: string;
  jobTitle?: string;
  jobTitles?: string[];
  badges?: string[];
  location?: string;
  availability?: string;
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData; // data as ProfileData

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const { name, photoUrl, description, descriptionHtml, resumeUrl, jobTitle, jobTitles, badges, location, availability, socials, nowText } = data;
const profileImage = await resolveAssetImage(photoUrl);

// Convert a Google Drive "view" link into an embeddable "preview" link for the modal
function getDrivePreviewUrl(url: string): string | null {
  if (!url) return null;
  const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (match && match[1]) {
    return `https://drive.google.com/file/d/${match[1]}/preview`;
  }
  return null;
}
const resumePreviewUrl = getDrivePreviewUrl(resumeUrl);
---

<section id="home" class="flex flex-col items-center justify-center section-container pt-24 md:pt-28 gap-1 min-h-[80vh] text-center">
  <div id="profile-photo-trigger" class="relative group mb-2 cursor-pointer">
    <div class="balloon-float w-24 h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]">
      <!-- Use Astro Image tag for optimization, fallback to img-->
      {profileImage ? (
        <Image
          src={profileImage}
          alt={name}
          width={96}
          height={96}
          densities={[1]}
          class="w-full h-full object-cover scale-110"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <img
          src={photoUrl || "/placeholder.jpeg"}
          alt={name}
          class="w-full h-full object-cover scale-110"
          onerror="this.onerror=null;this.src='/placeholder.jpeg';"
          loading="eager"
        />
      )}
    </div>
    <div class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"></div>
  </div>

    <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-gray leading-relaxed">
      Hello, I'm
    </p>
  </div>

  <div class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content" style="animation-delay: 300ms;">
    <h1
      class="glitch-name font-heading font-bold text-maintext tracking-tight leading-none whitespace-nowrap"
      data-text={name}
      style="font-size: clamp(1.05rem, 5.4vw, 4.25rem);"
    >
      {name}
    </h1>
    <p class="mt-2 text-xs font-mono text-subtext tracking-widest">sabbirtop111</p>
    {(jobTitles && jobTitles.length > 0) ? (
      <div class="font-mono text-sm text-accent/80 uppercase tracking-[0.2em] mt-4 flex items-center justify-center gap-1 min-h-[1.5em]">
        <span id="typing-text"></span><span class="typing-cursor">|</span>
      </div>
    ) : jobTitle && (
      <div class="font-mono text-sm text-accent/80 uppercase tracking-[0.2em] mt-4 flex items-center justify-center gap-3">
        {jobTitle}
      </div>
    )}
    {badges && badges.length > 0 && (
      <div class="flex items-center justify-center gap-2 mt-3 flex-wrap">
        {badges.map((badge) => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-body font-medium bg-white/5 border border-white/10 text-subtext">
            {badge}
          </span>
        ))}
      </div>
    )}

    {nowText && (
      <div class="flex justify-center mt-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-body font-medium bg-emerald-400/10 border border-emerald-400/25 text-emerald-400">
          🔥 {nowText}
        </span>
      </div>
    )}

    {location && (
      <div class="flex justify-center mt-5">
        <div class="relative w-20 h-20 rounded-full border border-accent/20 bg-accent/5 flex items-center justify-center overflow-hidden">
          <!-- radar rings -->
          <span class="absolute w-full h-full rounded-full border border-accent/10"></span>
          <span class="absolute w-[70%] h-[70%] rounded-full border border-accent/15"></span>
          <span class="absolute w-[40%] h-[40%] rounded-full border border-accent/20"></span>
          <!-- sweeping radar line -->
          <span class="absolute inset-0 radar-sweep"></span>
          <!-- glowing pin -->
          <span class="relative flex w-2.5 h-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex rounded-full w-2.5 h-2.5 bg-accent shadow-[0_0_8px_var(--color-accent)]"></span>
          </span>
        </div>
      </div>
    )}
    {(location || availability) && (
      <div class="flex items-center justify-center gap-4 mt-2 flex-wrap">
        {location && (
          <span class="inline-flex items-center gap-1 text-xs text-subtext">
            <Icon name="mdi:map-marker" class="w-3.5 h-3.5 text-accent/60" />
            {location}
          </span>
        )}
        {availability && (
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
            <span class="relative flex w-2 h-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full w-2 h-2 bg-emerald-400"></span>
            </span>
            {availability}
          </span>
        )}
      </div>
    )}

    <div class="flex items-center justify-center gap-8 mt-8 reveal-content" style="animation-delay: 500ms;">
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-heading font-bold text-accent">
          <span class="stat-counter" data-target={projectCount}>0</span>+
        </p>
        <p class="text-[11px] text-subtext font-body uppercase tracking-wider mt-1">Projects</p>
      </div>
      <div class="w-px h-8 bg-white/10"></div>
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-heading font-bold text-accent">
          <span class="stat-counter" data-target={skillCount}>0</span>+
        </p>
        <p class="text-[11px] text-subtext font-body uppercase tracking-wider mt-1">Skills</p>
      </div>
      <div class="w-px h-8 bg-white/10"></div>
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-heading font-bold text-accent">
          <span class="stat-counter" data-target={careerCount}>0</span>
        </p>
        <p class="text-[11px] text-subtext font-body uppercase tracking-wider mt-1">Milestones</p>
      </div>
    </div>
    <p 
      id="hero-description"
      class="text-gray font-body text-lg leading-relaxed mt-6" 
      data-en-html={descriptionHtml || description}
      data-bn-html={data.descriptionHtmlBn || ''}
      set:html={descriptionHtml || description} 
    />
  </div>

  <div class="mt-8 mb-4 reveal-content" style="animation-delay: 400ms;">
    {resumePreviewUrl ? (
      <button
        id="resume-preview-trigger"
        type="button"
        class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-white/10 rounded-full text-maintext font-body transition-all duration-300

               <!-- /* Mobile: Always active */ -->
               border-accent/50 bg-accent/10 shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)]

               <!-- /* Desktop: Reset and hover */ -->
               md:border-accent/50 md:bg-accent/10 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] 
               hover:scale-105"
      >
        <div class="flex flex-col items-center justify-center text-center">
          <span class="tracking-wide text-sm md:text-base font-medium transition-transform duration-300 md:translate-y-2 md:group-hover:translate-y-0" data-i18n="resume.view">
            View Resume
          </span>

          <span class="text-[10px] text-subtext font-light whitespace-nowrap transition-all duration-300 
                       opacity-100 translate-y-0 
                       md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0" data-i18n="resume.subtitle">
            Preview or Download
          </span>
        </div>

        <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
      </button>
    ) : (
      <a 
        href={resumeUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-white/10 rounded-full text-maintext font-body transition-all duration-300 border-accent/50 bg-accent/10 shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] md:border-accent/50 md:bg-accent/10 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] hover:scale-105"
      >
        <div class="flex flex-col items-center justify-center text-center">
          <span class="tracking-wide text-sm md:text-base font-medium">View Resume</span>
        </div>
        <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
      </a>
    )}
</div>

{resumePreviewUrl && (
  <div
    id="resume-modal-overlay"
    class="fixed inset-0 z-[90] bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4"
  >
    <div class="relative w-full max-w-2xl h-[80vh] bg-background border border-white/10 rounded-2xl overflow-hidden shadow-2xl flex flex-col">
      <div class="flex items-center justify-between px-4 py-3 border-b border-white/10">
        <p class="font-heading font-semibold text-maintext text-sm">Resume Preview</p>
        <div class="flex items-center gap-3">
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-accent hover:underline font-body">
            Open / Download
          </a>
          <button id="resume-modal-close" type="button" aria-label="Close" class="text-subtext hover:text-maintext transition-colors">
            <Icon name="mdi:close" class="w-5 h-5" />
          </button>
        </div>
      </div>
      <iframe
        id="resume-modal-iframe"
        src=""
        data-src={resumePreviewUrl}
        class="w-full h-full"
        loading="lazy"
        title="Resume Preview"
      ></iframe>
    </div>
  </div>
)}

  <div class="flex gap-6 mt-4 mb-4 reveal-content" style="animation-delay: 500ms;">
    {socials.filter((social) => social.url && social.url !== "#" && social.url !== "").map((social) => (
      <a 
        href={social.url} 
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
      >
        <Icon 
        name={social.icon} 
        class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300" 
      />

      <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
        {social.name}
      </span>
      </a>
    ))}
  </div>

  <div class="flex items-center justify-center gap-3 mb-8 reveal-content" style="animation-delay: 550ms;">
    <button
      id="copy-contact-btn"
      type="button"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-subtext text-[11px] font-body hover:border-accent/40 hover:text-accent transition-colors"
    >
      <Icon name="mdi:content-copy" class="w-3.5 h-3.5" />
      Copy Contact Info
    </button>
    <button
      id="share-site-btn"
      type="button"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-subtext text-[11px] font-body hover:border-accent/40 hover:text-accent transition-colors"
    >
      <Icon name="mdi:share-variant" class="w-3.5 h-3.5" />
      Share
    </button>
  </div>
</section>


<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* profile photo floating animation */

  /* When combined, the animation rule automatically merges these transforms */
  .avatar-container {
    animation: float 5s ease-in-out infinite alternate, wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    will-change: transform;
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      /* Moves up and slightly right */
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      /* Drifts left and stays elevated */
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      /* Returns to start */
      transform: translate(0, 0) rotate(0deg);
    }
  }

  .typing-cursor {
    color: var(--color-accent);
    animation: cursor-blink 0.9s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .radar-sweep {
    background: conic-gradient(from 0deg, color-mix(in srgb, var(--color-accent), transparent 100%) 0deg, color-mix(in srgb, var(--color-accent), transparent 70%) 30deg, transparent 60deg);
    animation: radar-spin 3s linear infinite;
  }

  @keyframes radar-spin {
    to { transform: rotate(360deg); }
  }

  .glitch-name {
    position: relative;
  }

  .glitch-name::before,
  .glitch-name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    background: transparent;
  }

  .glitch-name::before {
    color: #67e8f9;
    clip-path: inset(0 0 55% 0);
    transform: translate(-2px, 0);
    opacity: 0.55;
    animation: glitch-shift 3.2s infinite linear alternate-reverse;
  }

  .glitch-name::after {
    color: #f472b6;
    clip-path: inset(50% 0 0 0);
    transform: translate(2px, 0);
    opacity: 0.45;
    animation: glitch-shift 2.4s infinite linear alternate;
  }

  @keyframes glitch-shift {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-2px, 1px); }
    40% { transform: translate(2px, -1px); }
    60% { transform: translate(-1px, 0); }
    80% { transform: translate(1px, 1px); }
    100% { transform: translate(0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep {
      animation: none;
    }
    .glitch-name::before,
    .glitch-name::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing-cursor {
      animation: none;
    }
  }
</style>

<script define:vars={{ jobTitles }}>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('typing-text');
    if (!el || !jobTitles || jobTitles.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      el.textContent = jobTitles[0];
      return;
    }

    let titleIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    const TYPE_SPEED = 70;
    const DELETE_SPEED = 35;
    const PAUSE_AFTER_TYPE = 1400;
    const PAUSE_AFTER_DELETE = 300;

    function tick() {
      const current = jobTitles[titleIndex];

      if (!isDeleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);

        if (charIndex === current.length) {
          isDeleting = true;
          setTimeout(tick, PAUSE_AFTER_TYPE);
          return;
        }
        setTimeout(tick, TYPE_SPEED);
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);

        if (charIndex === 0) {
          isDeleting = false;
          titleIndex = (titleIndex + 1) % jobTitles.length;
          setTimeout(tick, PAUSE_AFTER_DELETE);
          return;
        }
        setTimeout(tick, DELETE_SPEED);
      }
    }

    tick();
  });

  // Resume Preview Modal
  document.addEventListener('DOMContentLoaded', () => {
    // Copy Contact Info
    const copyContactBtn = document.getElementById('copy-contact-btn');
    copyContactBtn?.addEventListener('click', () => {
      const email = document.querySelector('a[href^="mailto:"]')?.getAttribute('href')?.replace('mailto:', '') || '';
      const whatsapp = document.querySelector('a[href^="https://wa.me/"]')?.getAttribute('href') || '';
      const discord = document.querySelector('a[href*="discord.gg"]')?.getAttribute('href') || '';

      const text = [
        email && `Email: ${email}`,
        whatsapp && `WhatsApp: ${whatsapp}`,
        discord && `Discord: ${discord}`,
      ].filter(Boolean).join('\n');

      navigator.clipboard.writeText(text).then(() => {
        if (copyContactBtn) {
          const original = copyContactBtn.innerHTML;
          copyContactBtn.innerHTML = '✅ Copied!';
          setTimeout(() => (copyContactBtn.innerHTML = original), 1500);
        }
      });
    });

    // One-Click Share
    const shareBtn = document.getElementById('share-site-btn');
    shareBtn?.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        text: 'Check out my portfolio!',
        url: window.location.href,
      };
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch {}
      } else {
        navigator.clipboard.writeText(window.location.href);
        if (shareBtn) {
          const original = shareBtn.innerHTML;
          shareBtn.innerHTML = '✅ Link Copied!';
          setTimeout(() => (shareBtn.innerHTML = original), 1500);
        }
      }
    });
    // Animated number counters
    const counters = document.querySelectorAll('.stat-counter');
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 1200;
        const startTime = performance.now();

        function tick(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target).toString();
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterObserver.unobserve(el);
      });
    }, { threshold: 0.5 });

    counters.forEach((el) => counterObserver.observe(el));
    const trigger = document.getElementById('resume-preview-trigger');
    const overlay = document.getElementById('resume-modal-overlay');
    const closeBtn = document.getElementById('resume-modal-close');
    const iframe = document.getElementById('resume-modal-iframe');

    function openModal() {
      if (!overlay) return;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      if (iframe && iframe instanceof HTMLIFrameElement && !iframe.src) {
        iframe.src = iframe.dataset.src || '';
      }
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!overlay) return;
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }

    trigger?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  });
</script>
