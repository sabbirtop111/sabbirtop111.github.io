---
---

<div
  id="minigame-overlay"
  class="fixed inset-0 z-[95] bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4"
>
  <div class="relative w-full max-w-sm bg-background border border-accent/20 rounded-2xl shadow-2xl p-5 text-center">
    <button id="minigame-close" type="button" aria-label="Close" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/5 border border-white/10 text-subtext">✕</button>
    <p class="text-[10px] uppercase tracking-widest text-accent font-bold mb-1">🎮</p>
    <h3 class="text-lg font-heading font-bold text-maintext mb-1" data-en="Memory Flip" data-bn="মেমোরি ফ্লিপ">Memory Flip</h3>
    <p class="text-subtext text-xs font-body mb-3" data-en="Flip two cards. Match all pairs." data-bn="দুইটা কার্ড উল্টাও। জোড়া মিলাও।">Flip two cards. Match all pairs.</p>
    <div id="mem-grid" class="grid grid-cols-4 gap-2 mb-3"></div>
    <div class="flex justify-between text-sm">
      <span>Moves: <span id="mem-moves">0</span></span>
      <span>Best: <span id="mem-best">—</span></span>
    </div>
    <button id="mem-restart" type="button" class="mt-3 px-5 py-2 rounded-full bg-accent/15 border border-accent/40 text-xs font-semibold">Restart</button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('profile-photo-trigger');
    const overlay = document.getElementById('minigame-overlay');
    const closeBtn = document.getElementById('minigame-close');
    const grid = document.getElementById('mem-grid');
    const movesEl = document.getElementById('mem-moves');
    const bestEl = document.getElementById('mem-best');
    const restart = document.getElementById('mem-restart');
    if (!trigger || !overlay || !grid) return;

    const icons = ['🔥', '💜', '🎮', '⚡', '🌙', '💎', '🎯', '⭐'];
    let cards = [];
    let open = [];
    let lock = false;
    let moves = 0;
    let matched = 0;
    let best = parseInt(localStorage.getItem('mem-best') || '', 10);
    if (bestEl && Number.isFinite(best)) bestEl.textContent = String(best);

    let clickCount = 0;
    let clickTimer = null;
    trigger.addEventListener('click', () => {
      clickCount++;
      if (clickTimer) clearTimeout(clickTimer);
      clickTimer = setTimeout(() => (clickCount = 0), 1200);
      if (clickCount >= 5) {
        clickCount = 0;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
        setup();
      }
    });
    function closeGame() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }
    closeBtn?.addEventListener('click', closeGame);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeGame(); });

    function setup() {
      cards = [...icons, ...icons].sort(() => Math.random() - 0.5);
      open = [];
      lock = false;
      moves = 0;
      matched = 0;
      if (movesEl) movesEl.textContent = '0';
      grid.innerHTML = '';
      cards.forEach((icon, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'h-14 rounded-lg border border-white/10 bg-white/5 text-xl';
        btn.dataset.i = String(i);
        btn.textContent = '';
        btn.addEventListener('click', () => flip(btn, i));
        grid.appendChild(btn);
      });
    }

    function flip(btn, i) {
      if (lock || open.includes(i) || btn.dataset.done === '1') return;
      btn.textContent = cards[i];
      open.push(i);
      if (open.length < 2) return;
      moves += 1;
      if (movesEl) movesEl.textContent = String(moves);
      const [a, b] = open;
      if (cards[a] === cards[b]) {
        grid.children[a].dataset.done = '1';
        grid.children[b].dataset.done = '1';
        open = [];
        matched += 1;
        if (matched === icons.length) {
          if (!Number.isFinite(best) || moves < best) {
            best = moves;
            localStorage.setItem('mem-best', String(best));
            if (bestEl) bestEl.textContent = String(best);
          }
        }
      } else {
        lock = true;
        setTimeout(() => {
          grid.children[a].textContent = '';
          grid.children[b].textContent = '';
          open = [];
          lock = false;
        }, 700);
      }
    }
    restart?.addEventListener('click', setup);
  });
</script>
