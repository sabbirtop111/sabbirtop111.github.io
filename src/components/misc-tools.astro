---

<section class="mt-16 space-y-8">
  <div class="rounded-2xl border border-accent/15 bg-accent/5 p-6 md:p-8">
    <p class="text-[10px] uppercase tracking-widest font-bold text-sky-400 mb-1" data-i18n="mini.title">Mini Tools</p>
    <h3 class="text-xl font-heading font-bold text-maintext mb-1" data-en="Age Calculator" data-bn="বয়স ক্যালকুলেটর">Age Calculator</h3>
    <p class="text-subtext text-sm font-body mb-5" data-en="Tap the date. Time sets itself and keeps counting." data-bn="তারিখে ট্যাপ করো। সময় নিজে বসবে, রিয়েল টাইমে চলবে।">Tap the date. Time sets itself and keeps counting.</p>
    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
      <label class="flex-1 text-xs text-subtext">
        <span data-en="Date of birth" data-bn="জন্ম তারিখ">Date of birth</span>
        <input id="age-dob" type="date" class="mt-1 w-full px-4 py-2.5 rounded-lg bg-background/60 border border-white/10 text-maintext text-sm focus:outline-none focus:border-accent/50" />
      </label>
      <button id="age-btn" type="button" class="px-5 py-2.5 rounded-lg bg-accent/20 border border-accent/40 text-maintext text-sm font-semibold">
        <span data-en="Calculate" data-bn="হিসাব করো">Calculate</span>
      </button>
    </div>
    <p id="age-result" class="text-maintext font-body text-sm mt-4 min-h-6"></p>
    <div id="age-boxes" class="hidden mt-3 grid grid-cols-3 sm:grid-cols-6 gap-2 text-center"></div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {cards.map((card) => (
      <a href={card.href} class="group rounded-2xl border border-accent/15 bg-accent/5 p-5 hover:border-accent/40 transition-colors block">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-heading font-bold text-maintext" data-en={card.title} data-bn={card.titleBn}>{card.title}</h3>
          <span class="text-[11px] text-accent" data-i18n="mini.open">Open</span>
        </div>
        <div class="tool-preview text-subtext" set:html={card.html} />
      </a>
    ))}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dobInput = document.getElementById('age-dob');
    const ageResult = document.getElementById('age-result');
    const ageBtn = document.getElementById('age-btn');
    const ageBoxes = document.getElementById('age-boxes');
    let timer = 0;
    function ageParts(dob) {
      const now = new Date();
      let years = now.getFullYear() - dob.getFullYear();
      let months = now.getMonth() - dob.getMonth();
      let days = now.getDate() - dob.getDate();
      let hours = now.getHours() - dob.getHours();
      let minutes = now.getMinutes() - dob.getMinutes();
      let seconds = now.getSeconds() - dob.getSeconds();
      if (seconds < 0) { minutes -= 1; seconds += 60; }
      if (minutes < 0) { hours -= 1; minutes += 60; }
      if (hours < 0) { days -= 1; hours += 24; }
      if (days < 0) {
        months -= 1;
        days += new Date(now.getFullYear(), now.getMonth(), 0).getDate();
      }
      if (months < 0) { years -= 1; months += 12; }
      return { years, months, days, hours, minutes, seconds };
    }
    function paint() {
      if (!(dobInput instanceof HTMLInputElement) || !ageResult || !dobInput.value) return;
      const raw = dobInput.value.trim();
      const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (!match) {
        ageResult.textContent = 'Pick a date.';
        return;
      }
      const dob = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), 0, 0, 0);
      if (Number.isNaN(dob.getTime()) || dob > new Date()) {
        ageResult.textContent = 'Birth date must be in the past.';
        return;
      }
      const a = ageParts(dob);
      const bn = localStorage.getItem('site-lang') === 'bn';
      ageResult.textContent = bn
        ? `${a.years} বছর ${a.months} মাস ${a.days} দিন ${a.hours} ঘণ্টা ${a.minutes} মিনিট ${a.seconds} সেকেন্ড`
        : `${a.years} years ${a.months} months ${a.days} days ${a.hours} hours ${a.minutes} minutes ${a.seconds} seconds old`;
      if (!ageBoxes) return;
      const labels = bn
        ? ['বছর', 'মাস', 'দিন', 'ঘণ্টা', 'মিনিট', 'সেকেন্ড']
        : ['Years', 'Months', 'Days', 'Hours', 'Min', 'Sec'];
      const values = [a.years, a.months, a.days, a.hours, a.minutes, a.seconds];
      ageBoxes.innerHTML = '';
      values.forEach((value, i) => {
        const box = document.createElement('div');
        box.className = 'rounded-xl border border-white/10 bg-black/20 py-3';
        const n = document.createElement('p');
        n.className = 'text-xl font-heading font-bold text-maintext';
        n.textContent = String(value);
        const l = document.createElement('p');
        l.className = 'text-[10px] uppercase text-subtext';
        l.textContent = labels[i];
        box.append(n, l);
        ageBoxes.append(box);
      });
      ageBoxes.classList.remove('hidden');
    }
    function calc() {
      paint();
      window.clearInterval(timer);
      timer = window.setInterval(paint, 1000);
    }
    ageBtn?.addEventListener('click', calc);
    dobInput?.addEventListener('change', calc);
  });
</script>
