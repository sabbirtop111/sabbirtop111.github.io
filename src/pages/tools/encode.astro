---
import Layout from '../../layouts/Layout.astro';
import homeData from '../../data/home.json';
---
<Layout title="Base64 / URL | GAMER SABBIR" personName={homeData.name} description="Encode or decode Base64 and URL text." siteUrl={homeData.siteUrl} lang="en" socials={homeData.socials}>
  <main class="section-container min-h-[80vh]"><div class="container mx-auto max-w-2xl">
    <a href="/#tools" class="text-sm text-accent mb-6 inline-block">← Home</a>
    <h1 class="text-3xl font-heading font-bold text-maintext mb-2">Base64 / URL</h1>
    <p class="text-subtext text-sm mb-5" data-en="Paste text. Encode or decode. Stays on your phone." data-bn="টেক্সট দাও। এনকোড বা ডিকোড করো। ফোনেই থাকে।">Paste text. Encode or decode. Stays on your phone.</p>
    <textarea id="enc-in" rows="6" class="w-full mb-3 px-3 py-2 rounded-xl bg-background/60 border border-white/10 text-maintext text-sm"></textarea>
    <div class="flex flex-wrap gap-2 mb-3">
      <button id="b64e" class="px-3 py-2 rounded-lg bg-accent/20 border border-accent/40 text-sm">Base64 Encode</button>
      <button id="b64d" class="px-3 py-2 rounded-lg border border-white/10 text-sm">Base64 Decode</button>
      <button id="urle" class="px-3 py-2 rounded-lg border border-white/10 text-sm">URL Encode</button>
      <button id="urld" class="px-3 py-2 rounded-lg border border-white/10 text-sm">URL Decode</button>
    </div>
    <textarea id="enc-out" rows="6" readonly class="w-full px-3 py-2 rounded-xl bg-background/60 border border-white/10 text-maintext text-sm"></textarea>
  </div></main>
</Layout>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inn = document.getElementById('enc-in');
    const out = document.getElementById('enc-out');
    const val = () => inn instanceof HTMLTextAreaElement ? inn.value : '';
    const set = (t) => { if (out instanceof HTMLTextAreaElement) out.value = t; };
    document.getElementById('b64e')?.addEventListener('click', () => { try { set(btoa(unescape(encodeURIComponent(val())))); } catch { set('Could not encode'); } });
    document.getElementById('b64d')?.addEventListener('click', () => { try { set(decodeURIComponent(escape(atob(val())))); } catch { set('Could not decode'); } });
    document.getElementById('urle')?.addEventListener('click', () => set(encodeURIComponent(val())));
    document.getElementById('urld')?.addEventListener('click', () => { try { set(decodeURIComponent(val())); } catch { set('Could not decode'); } });
  });
</script>
