---
import Layout from '../../layouts/Layout.astro';
import homeData from '../../data/home.json';
import FreeFireChecker from '../../components/freefire-checker.astro';
---
<Layout title="Free Fire Info | GAMER SABBIR" personName={homeData.name} description="Check Free Fire player info by UID." siteUrl={homeData.siteUrl} lang="en" socials={homeData.socials}>
  <main class="section-container min-h-[80vh]"><div class="container mx-auto max-w-3xl">
    <a href="/#tools" class="text-sm text-accent mb-6 inline-block">← Home</a>
    <FreeFireChecker />
  </div></main>
</Layout>
