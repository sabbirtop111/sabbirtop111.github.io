---
import Layout from '../../layouts/Layout.astro';
import homeData from '../../data/home.json';
import FreeFireBio from '../../components/freefire-bio.astro';
---
<Layout title="Free Fire Bio Updater | GAMER SABBIR" personName={homeData.name} description="Update your Free Fire in-game bio." siteUrl={homeData.siteUrl} lang="en" socials={homeData.socials}>
  <main class="section-container min-h-[80vh]"><div class="container mx-auto max-w-3xl">
    <a href="/#tools" class="text-sm text-accent mb-6 inline-block">← Home</a>
    <FreeFireBio />
  </div></main>
</Layout>
