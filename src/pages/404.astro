---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/home.json';
---

<Layout
  title="404 — Page not found | GAMER SABBIR"
  personName={homeData.name}
  description="This page does not exist on Gamer Sabbir's portfolio."
  siteUrl={homeData.siteUrl}
  lang="en"
  socials={homeData.socials}
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20">
    <p class="font-mono text-accent tracking-[0.35em] text-xs mb-4">ERROR_CODE</p>
    <h1 class="glitch-404 font-heading font-bold text-maintext leading-none" data-text="404">404</h1>
    <p class="mt-6 text-subtext font-body max-w-md" data-en="This map marker is empty. The page you want is not in this server." data-bn="এই পেজটা নেই। হোমে ফিরে যাও।">
      This map marker is empty. The page you want is not in this server.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="px-6 py-2.5 rounded-full bg-accent/20 border border-accent/40 text-maintext text-sm font-semibold hover:bg-accent/30 transition-colors" data-en="Back to home" data-bn="হোমে যাও">
        Back to home
      </a>
      <a href="/#projects" class="px-6 py-2.5 rounded-full border border-white/10 text-subtext text-sm hover:text-maintext hover:border-accent/40 transition-colors" data-en="See projects" data-bn="প্রজেক্ট দেখো">
        See projects
      </a>
    </div>
  </section>
</Layout>

<style>
  .glitch-404 {
    font-size: clamp(5rem, 18vw, 10rem);
    position: relative;
    letter-spacing: -0.04em;
  }
  .glitch-404::before,
  .glitch-404::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch-404::before {
    color: #22F0FF;
    transform: translate(-6px, 0);
    opacity: 0.7;
    clip-path: inset(0 0 55% 0);
  }
  .glitch-404::after {
    color: #FF2EEA;
    transform: translate(6px, 0);
    opacity: 0.7;
    clip-path: inset(50% 0 0 0);
  }
</style>
