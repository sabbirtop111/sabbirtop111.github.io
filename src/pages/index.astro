---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import Tech from "../components/tech.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Community from "../components/community.astro";
import Footer from "../components/footer.astro";
import Career from "../components/career.astro";
import MusicPlayer from "../components/music-player.astro";
import Tools from "../components/tools.astro";
import localData from '../data/home.json';

interface Social {
  name: string;
  url: string;
  icon: string;
  showInContact: boolean;
}

interface ProfileData {
  name: string;
  webpageTitle: string;
  description?: string;
  jobTitle?: string;
  keywords?: string;
  siteUrl?: string;
  twitterHandle?: string;
  ogImageUrl?: string;
  lang?: string;
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData;

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const {
  name,
  webpageTitle,
  description,
  jobTitle,
  keywords,
  siteUrl,
  twitterHandle,
  ogImageUrl,
  lang,
  socials,
} = data;
---

<Layout
  title={webpageTitle}
  personName={name}
  description={description}
  jobTitle={jobTitle}
  keywords={keywords}
  siteUrl={siteUrl}
  twitterHandle={twitterHandle}
  ogImageUrl={ogImageUrl}
  lang={lang}
  socials={socials}
>
  <MusicPlayer />
  <Nav />
	<Home />
	<Tools />
	<Career />
	<Projects />
	<Tech />
	<Community />
	<Contact />
	<Footer />
</Layout>
