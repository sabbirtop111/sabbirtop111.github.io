---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/home.json';
---

<Layout
  title="Secret room | GAMER SABBIR"
  personName={homeData.name}
  description="You found the hidden page."
  siteUrl={homeData.siteUrl}
  lang="en"
  socials={homeData.socials}
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <p class="font-mono text-accent text-xs tracking-[0.35em] mb-4">KONAMI_OK</p>
    <h1 class="font-heading font-bold text-4xl md:text-6xl text-maintext mb-4">You found it.</h1>
    <p class="text-subtext max-w-md mb-8">
      ↑ ↑ ↓ ↓ ← → ← → B A — old school unlock. No hidden code, just a secret room.
    </p>
    <a href="/" class="px-6 py-2.5 rounded-full bg-accent/20 border border-accent/40 text-sm font-semibold">Back to spawn</a>
  </section>
</Layout>
